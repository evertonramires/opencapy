# REQUIRED
HEARTBEAT_INTERVAL_SECONDS=10
MEMORY_LENGTH_MESSAGES=10
NOTEBOOK_LENGTH_CHARACTERS=1000
TIMEZONE=Europe/Lisbon

# To run on your Claude subscription through the Claude Code CLI instead of an API key.
# Needs the claude CLI on PATH and a logged in session (run 'claude' once and sign in).
# The LLM_* settings below stay in place and are used as the fallback whenever the CLI fails.
ENABLE_CLAUDE_CODE=false
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_SMARTER_MODEL=opus
CLAUDE_CODE_BLACKSMITH_MODEL=opus
# Claude Code's own tools, offered on top of Open Capy's. Bash here means real shell access.
CLAUDE_CODE_BUILTIN_TOOLS=Bash,Read,Write,WebSearch
CLAUDE_CODE_TIMEOUT_SECONDS=600
# Reasoning effort: low, medium, high, xhigh or max. Blank keeps the CLI default. Change it live with /effort.
CLAUDE_CODE_EFFORT=
# Where the Claude Code CLI keeps its OAuth credentials, read to check the subscription usage
CLAUDE_CODE_CONFIG_DIR=~/.claude
# Queue background work when the 5 hour usage window is at least this used (percent).
# Set it to 100 to effectively turn buffering off, it then only applies once the window is fully spent.
# Above it the agent stops spending the Claude window on its own background messages and chat uses the LLM_* settings.
USAGE_BUFFER_THRESHOLD_PERCENT=80

# To run with remote model
# ENABLE_LMSTUDIO=false
# LLM_API_HOST=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=

# To run with local model
ENABLE_LMSTUDIO=true
LLM_API_HOST=http://127.0.0.1:1234 
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=google/gemma-4-e4b

FALLBACK_LLM_API_HOST=https://api.openai.com/v1/chat/completions
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gpt-5.4

LLM_TEMPERATURE=1.2
LLM_TOP_P=0.95

# Sign every message, comment and note with the model that actually wrote it, read from the response —
# so a silent switch to the fallback or the buffered-window model is visible instead of a mystery
ENABLE_MODEL_WATERMARK=true

ANNOUNCE_TOOL_CALLS=true
ANNOUNCE_ERRORS=true

ENABLE_CURRENCY=true
ENABLE_NEWS=true
ENABLE_WEATHER=true
ENABLE_INTERNET=false
ENABLE_WEBSEARCH=false
ENABLE_SHELL=false

# OPTIONAL
ENABLE_BROWSER=false
BROWSER_API_HOST=http://localhost:8000

# OPTIONAL
ENABLE_BLACKSMITH=false
BLACKSMITH_LLM_API_HOST=https://api.openai.com/v1/chat/completions
BLACKSMITH_LLM_API_KEY=
BLACKSMITH_LLM_MODEL=gpt-5.5

# OPTIONAL
ENABLE_TELEGRAM=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL
# Transcribe Telegram voice notes and audio files, riding on LLM_API_HOST and LLM_API_KEY
ENABLE_TRANSCRIPTION=false
TRANSCRIPTION_MODEL=groq/whisper-large-v3-turbo

# OPTIONAL
ENABLE_SMARTER=false
SMARTER_LLM_API_HOST=https://api.openai.com/v1/chat/completions
SMARTER_LLM_API_KEY=
SMARTER_LLM_MODEL=gpt-5.4

# OPTIONAL
ENABLE_EMAIL=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# OPTIONAL
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OPTIONAL
ENABLE_GITHUB=false
GITHUB_TOKEN=

# OPTIONAL
# Vikunja to-do list
ENABLE_VIKUNJA=false
# Your Vikunja instance address, e.g. https://try.vikunja.io
VIKUNJA_API_HOST=
# API token created in Vikunja under Settings > API Tokens
VIKUNJA_API_TOKEN=
# Project (list) where new to-dos go by default, 1 is usually Inbox
VIKUNJA_DEFAULT_PROJECT_ID=1
# How often (seconds) the bot checks Vikunja for to-dos added outside the bot and notifies you about them
VIKUNJA_WATCH_INTERVAL_SECONDS=30
# 24h format UTC hour for the daily focus message (one suggested to-do to gently start the day), -1 disables it
VIKUNJA_DAILY_FOCUS_HOUR=8
# 24h format UTC hour for the daily nudge asking for due dates on to-dos that have none (keeps the Gantt view useful), -1 disables it
VIKUNJA_DATE_NUDGE_HOUR=17
# Let the agent break multi-step to-dos into named subtasks (e.g. '[ change car tyres - 1 ] lift car')
ENABLE_VIKUNJA_SUBTASKS=false
# Day of the week for the stale to-do sweep and the weekly wins message (0=Monday ... 6=Sunday), -1 disables both
WEEKLY_REVIEW_DAY=-1
# 24h format UTC hour those weekly messages go out
WEEKLY_REVIEW_HOUR=9
# A to-do untouched for this many days counts as stale and gets offered up for shrinking, snoozing or dropping
STALE_TODO_DAYS=21
# Watch the comments on your to-dos, so commenting on a task in Vikunja steers it and the agent answers in the thread
ENABLE_TODO_COMMENTS=false
# Let the agent rewrite a vague to-do title into the first concrete action (the original is kept, /undotitle puts it back)
ENABLE_TODO_RETITLE=false
# Sort every new to-do into the urgent/important boxes and tag what else is true about it (who could do it, how long it takes,
# where it can be done). Run /triagesetup once afterwards to create the labels and the Eisenhower board in Vikunja
ENABLE_TODO_TRIAGE=false
# Tag every triaged to-do with how many pomodori it should take (🍅 2), and each checklist step with its own
ENABLE_TODO_POMODORO=false
# How long one pomodoro of focused work is, in minutes
POMODORO_MINUTES=25
# How long the break after one is, in minutes
POMODORO_BREAK_MINUTES=5
# Catch the same to-do written down twice in different words: nothing is added, the new details are merged into the existing one
ENABLE_TODO_DEDUPE=false
# The watcher's friendly hello when a to-do arrives; off = one compact line only, sent after the assessment finishes
ENABLE_TODO_INSTANT_ACK=true
# How alike two to-dos have to read to count as the same one, 0 to 1. Lower catches more and asks more often
TODO_DUPLICATE_THRESHOLD=0.55
# A to-do finished this recently still counts as a duplicate, so a chore just done isn't silently written down again
TODO_DUPLICATE_DONE_DAYS=14

# OPTIONAL
# Autopilot: the agent takes to-dos on itself, researches them, and writes what it finds
# into the to-do description so the task is smaller and more concrete when you open it
ENABLE_AUTOPILOT=false
# How many to-dos it may research per day. Protects the Claude usage window and your attention
AUTOPILOT_MAX_PER_DAY=5

# OPTIONAL
# dsh agent: a /start comment on a Vikunja task spawns a deepseek-harness session for it, named
# "#<id> <title>", primed with the task and its thread, and able to talk back through the task's
# comments (vikunja MCP tools in the preset). Later comments on the task steer it, /stop cancels.
ENABLE_DSH=false
# The RPC endpoint (must be inside dsh's --trusted-host fence) and the link put in comments
DSH_URL=
DSH_PUBLIC_URL=
# Preset the sessions run with; it should carry the vikunja MCP server (see contrib/vikunja-mcp)
DSH_AGENT_PRESET=vikunja
# Working directory for the sessions on the dsh host
DSH_CWD=
# Optional model override, e.g. terra-think/qwen3.8-27b; empty keeps the dsh default
DSH_MODEL=
DSH_MODEL_PROVIDER=terra-think
# Cookie bootstrap: ssh destination of the dsh host, used to grep the launch token from
# "journalctl --user -u dsh.service" and exchange it for the auth cookie (lasts ~30 days).
# Or paste a cookie ("name=value") into DSH_COOKIE to skip ssh entirely.
DSH_SSH_HOST=
DSH_COOKIE=

# OPTIONAL
# Coding agent: for ai-can-code to-dos that need code, a repo, shell commands or another machine.
# Needs ENABLE_CLAUDE_CODE. Only ever OFFERED as a button on the triage message — it runs the Claude
# Code CLI with real shell access and no permission prompts on this machine (and over ssh, if your
# notes name a host), which is exactly why nothing starts until you tap
ENABLE_CODER=false
CODER_MODEL=opus
# A coding job may legitimately take a while; it runs on a background thread, chat stays responsive
CODER_TIMEOUT_SECONDS=3600
# Runs per day, protecting the usage window
CODER_MAX_PER_DAY=2
# Each job gets its own subdirectory in here
CODER_WORKDIR=~/coderwork
CODER_BUILTIN_TOOLS=Bash,Read,Write,Edit,Glob,Grep,WebSearch
# Free text the agent gets about your machines: names, ssh aliases, what lives where.
# e.g. "serverton is my homelab server, reachable as 'ssh serverton', Debian 12, docker lives there"
CODER_NOTES=

# OPTIONAL
# Nightly journal: asks for tomorrow's first 3 tasks and today's 3 achievements, reminds you of your
# picks in the morning, and picks 3 itself when you didn't answer. Entries mirror into AppFlowy when
# it's enabled, one page per day under a 'Journal' page
ENABLE_JOURNAL=false
# UTC hour for the evening ask, -1 disables
JOURNAL_EVENING_HOUR=-1
# Optional: pin the AppFlowy page journal entries nest under; blank = find-or-create a page named 'Journal'
APPFLOWY_JOURNAL_PARENT_ID=

# OPTIONAL
# Focus sprints: /sprint <todo_id> starts a timer and checks in when it's up
ENABLE_SPRINTS=false
# Default sprint length in minutes
SPRINT_MINUTES=25

# OPTIONAL
# Actions the agent must get your approval for before they happen. It drafts them and
# sends you a Telegram card with Send / Change / Drop buttons instead of acting.
# Comma separated tool names. Leave blank for the default (send_email,send_sms).
# Add run_shell_command, browse_url, create_github_issue or add_calendar_event to widen it.
# Set to 'none' to turn the gate off entirely.
APPROVAL_REQUIRED_TOOLS=
# Drafts nobody answered are dropped after this many hours, so nothing fires on stale intent
APPROVAL_EXPIRY_HOURS=24

# OPTIONAL
# AppFlowy knowledge base (Vikunja stays the to-do list)
ENABLE_APPFLOWY=false
# Your AppFlowy instance address, e.g. https://beta.appflowy.cloud or your self-hosted one
APPFLOWY_API_HOST=
# AppFlowy has no API token, so the login credentials are the only way in
APPFLOWY_EMAIL=
APPFLOWY_PASSWORD=
# Leave blank to use the first workspace of the account
APPFLOWY_WORKSPACE_ID=
# Database new rows go to when the agent isn't told which one.
# Leave blank to let the agent pick: it is told which databases exist and asks for one when unsure.
APPFLOWY_DEFAULT_DATABASE_ID=

# OPTIONAL
# Google calendar for now
ENABLE_CALENDAR=false
# 24h format, hour of the day to check for today's events and notify the user
CALENDAR_DAILY_CHECK_HOUR=7
CALENDAR_ID=
CALENDAR_DEFAULT_DAYS_AHEAD=7
CALENDAR_DEFAULT_MAX_RESULTS=30
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/calendar/callback

# OPTIONAL
CHAT_API_HOST=http://localhost:8000
# Uncomment to reach the chat page from other devices (e.g. over Tailscale)
# CHAT_API_BIND_HOST=0.0.0.0
