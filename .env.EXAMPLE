# REQUIRED
HEARTBEAT_INTERVAL_SECONDS=10
MEMORY_LENGTH_MESSAGES=10
NOTEBOOK_LENGTH_CHARACTERS=1000
TIMEZONE=Europe/Lisbon

# To run on your Claude subscription through the Claude Code CLI instead of an API key.
# Needs the claude CLI on PATH and a logged in session (run 'claude' once and sign in).
# The LLM_* settings below stay in place and are used as the fallback whenever the CLI fails.
ENABLE_CLAUDE_CODE=false
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_SMARTER_MODEL=opus
CLAUDE_CODE_BLACKSMITH_MODEL=opus
# Claude Code's own tools, offered on top of Open Capy's. Bash here means real shell access.
CLAUDE_CODE_BUILTIN_TOOLS=Bash,Read,Write,WebSearch
CLAUDE_CODE_TIMEOUT_SECONDS=600

# To run with remote model
# ENABLE_LMSTUDIO=false
# LLM_API_HOST=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=

# To run with local model
ENABLE_LMSTUDIO=true
LLM_API_HOST=http://127.0.0.1:1234 
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=google/gemma-4-e4b

FALLBACK_LLM_API_HOST=https://api.openai.com/v1/chat/completions
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gpt-5.4

LLM_TEMPERATURE=1.2
LLM_TOP_P=0.95

ANNOUNCE_TOOL_CALLS=true
ANNOUNCE_ERRORS=true

ENABLE_CURRENCY=true
ENABLE_NEWS=true
ENABLE_WEATHER=true
ENABLE_INTERNET=false
ENABLE_WEBSEARCH=false
ENABLE_SHELL=false

# OPTIONAL
ENABLE_BROWSER=false
BROWSER_API_HOST=http://localhost:8000

# OPTIONAL
ENABLE_BLACKSMITH=false
BLACKSMITH_LLM_API_HOST=https://api.openai.com/v1/chat/completions
BLACKSMITH_LLM_API_KEY=
BLACKSMITH_LLM_MODEL=gpt-5.5

# OPTIONAL
ENABLE_TELEGRAM=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL
ENABLE_SMARTER=false
SMARTER_LLM_API_HOST=https://api.openai.com/v1/chat/completions
SMARTER_LLM_API_KEY=
SMARTER_LLM_MODEL=gpt-5.4

# OPTIONAL
ENABLE_EMAIL=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# OPTIONAL
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OPTIONAL
ENABLE_GITHUB=false
GITHUB_TOKEN=

# OPTIONAL
# Vikunja to-do list
ENABLE_VIKUNJA=false
# Your Vikunja instance address, e.g. https://try.vikunja.io
VIKUNJA_API_HOST=
# API token created in Vikunja under Settings > API Tokens
VIKUNJA_API_TOKEN=
# Project (list) where new to-dos go by default, 1 is usually Inbox
VIKUNJA_DEFAULT_PROJECT_ID=1
# How often (seconds) the bot checks Vikunja for to-dos added outside the bot and notifies you about them
VIKUNJA_WATCH_INTERVAL_SECONDS=30
# 24h format UTC hour for the daily focus message (one suggested to-do to gently start the day), -1 disables it
VIKUNJA_DAILY_FOCUS_HOUR=8
# 24h format UTC hour for the daily nudge asking for due dates on to-dos that have none (keeps the Gantt view useful), -1 disables it
VIKUNJA_DATE_NUDGE_HOUR=17
# Let the agent break multi-step to-dos into named subtasks (e.g. '[ change car tyres - 1 ] lift car')
ENABLE_VIKUNJA_SUBTASKS=false

# OPTIONAL
# AppFlowy knowledge base (Vikunja stays the to-do list)
ENABLE_APPFLOWY=false
# Your AppFlowy instance address, e.g. https://beta.appflowy.cloud or your self-hosted one
APPFLOWY_API_HOST=
# AppFlowy has no API token, so the login credentials are the only way in
APPFLOWY_EMAIL=
APPFLOWY_PASSWORD=
# Leave blank to use the first workspace of the account
APPFLOWY_WORKSPACE_ID=
# Database new rows go to when the agent isn't told which one
APPFLOWY_DEFAULT_DATABASE_ID=

# OPTIONAL
# Google calendar for now
ENABLE_CALENDAR=false
# 24h format, hour of the day to check for today's events and notify the user
CALENDAR_DAILY_CHECK_HOUR=7
CALENDAR_ID=
CALENDAR_DEFAULT_DAYS_AHEAD=7
CALENDAR_DEFAULT_MAX_RESULTS=30
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/calendar/callback

# OPTIONAL
CHAT_API_HOST=http://localhost:8000
